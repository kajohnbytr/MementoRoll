# Public application origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. The publishable key is safe for browser use; the
# secret key must only be used by server-side code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Private Cloudflare R2 bucket and S3-compatible endpoint credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mementoroll-private
R2_ENDPOINT=

# At least 32 random bytes each. Rotate through a documented session strategy.
SESSION_SECRET=
TOKEN_HASH_SECRET=

# Optional monitoring. Keep blank to disable Sentry.
SENTRY_DSN=

# Development-only checkout. Never enable in production.
TEST_PAYMENT_MODE=false
